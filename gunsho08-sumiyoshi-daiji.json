 "poems": [
  {
   "seq": "1",
   "text": "くまもなき月に心をなくさめてうきみに年の積りぬる哉",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "月〓み心もすめる秋のよや身かうき雲の晴間なるらん",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "海士の舟さしてもいはしつきひとの桂のかちをとるにま",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "みつ汐のひるまに過る東路や〓見か關に紅葉しにけり",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "散ぬへき紅葉のにしき夕風のた〓ぬさきにときてもみる哉",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "〓見かたやしほに染る紅葉はにもみちのにしき立もまさ",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "しら露のおきいて聞はさほ山に曉かけてをしか鳴なり",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "柴の戶を嵐の過る明方に妻よふ鹿は聲たてつなり",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "さ衣の袂す〓しき風よりもを鹿の聲そ身にはしみける",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "とふ人もなき古里の暮ことに誰まつ虫のたえす鳴らん",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "眞葛原なひく夕の秋風につらみ顔なる松虫の聲",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "身をしれ(っめイ)はみな松虫としりなから恨顏なる聲やま",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "糸萩のいとはる〓身としりぬれはくるも苦しき心地こそすれ",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "我をこそ忘れもはてめ諸共に植し小萩の花はきてみよ",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "をしなへて宿の小萩のすゑよはみ露もこ〓ろそとまらさ",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "女郞花咲野へとに身にしみて花心なる戀もするかな",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "我戀のなくさむつまにあらねともおらて過うき女郞花哉",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "をみなへしくちなし色の花なれはいかにもえこそいはれ",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "いつとなく忍ふもくるし篠薄はに出て人に逢よしもかな",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "いかにせんまの〓入江に汐みちて泪にしつむ篠のを薄",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "おもふ事大野にたてるしのす〓き忍ふ心の有かたき哉と",
   "kana": "",
   "speaker": "",
   "page": 65,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "そよ〓〓と荻吹風は音すれと人はたのむる〓とのはもなし",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "よさの浦に一村たてる濵荻の又たくひなき戀もする哉",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "汀なる鹽あしに紛ふ濵荻はよしとそ見ゆるよさの浦人",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "白露のむすひをけはや蘭花の下ひもとけかてにする",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "匂ふ香を君によそへて藤はかまなつさふ袖に露そこほる〓",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "蘭露の結ふをみるよりも玉ちる袖はなつかしきかな",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "君かへん世を長月に咲ぬれはいく秋としもしら菊の花",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "みる人もよを長月の花なれは久しと聞そうれしかりける",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "と〓こほる言のはなれはよし水に流れさり鳬菊の雫も",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "藻汐艸かき散すよりちかの浦の玉つ島守みるめ耻かし",
   "kana": "",
   "speaker": "",
   "page": 66,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
